# ============================================================================
# Commerce Lab Retail - Backend Microservices Environment Configuration
# Chiến lược: Chung 1 DB (commerce_lab), tách 9 Schema riêng bằng search_path
# Khi cần tách DB vật lý sau này: chỉ cần đổi DATABASE_URL_* (0 sửa code)
# ============================================================================

ENV=development
TZ=UTC
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

# --- Low-Resource Benchmark Cap (Mỗi service <= 250MB RAM & <= 0.25 CPU) ---
GOMAXPROCS=1
GOMEMLIMIT=220MiB
NODE_OPTIONS=--max-old-space-size=180
UV_THREADPOOL_SIZE=2

# --- Service HTTP Ports ---
API_GATEWAY_PORT=8080
CATALOG_PRICING_PORT=8081
INVENTORY_WAREHOUSE_PORT=8082
ORDER_CHECKOUT_PORT=8083
PAYMENT_PORT=8084
FULFILLMENT_SHIPPING_PORT=8085
LEDGER_RECONCILIATION_PORT=8086
IAM_AUTH_PORT=8087
BACKOFFICE_SUPPORT_PORT=8088
NOTIFICATION_PORT=8089

# --- PostgreSQL (1 Shared DB `commerce_lab` + 9 Isolated Schemas via search_path) ---
DATABASE_URL_IAM=postgres://iam_svc_user:iam_secret@localhost:5432/commerce_lab?sslmode=disable&search_path=iam
DATABASE_URL_PRICING=postgres://pricing_svc_user:pricing_secret@localhost:5432/commerce_lab?sslmode=disable&search_path=pricing
DATABASE_URL_INVENTORY=postgres://inventory_svc_user:inventory_secret@localhost:5432/commerce_lab?sslmode=disable&search_path=inventory
DATABASE_URL_ORDERS=postgres://order_svc_user:order_secret@localhost:5432/commerce_lab?sslmode=disable&search_path=orders
DATABASE_URL_PAYMENTS=postgres://payment_svc_user:payment_secret@localhost:5432/commerce_lab?sslmode=disable&search_path=payments
DATABASE_URL_FULFILLMENT=postgres://fulfillment_svc_user:fulfillment_secret@localhost:5432/commerce_lab?sslmode=disable&search_path=fulfillment
DATABASE_URL_LEDGER=postgres://ledger_svc_user:ledger_secret@localhost:5432/commerce_lab?sslmode=disable&search_path=ledger
DATABASE_URL_SUPPORT=postgres://support_svc_user:support_secret@localhost:5432/commerce_lab?sslmode=disable&search_path=support
DATABASE_URL_NOTIFICATIONS=postgres://notify_svc_user:notify_secret@localhost:5432/commerce_lab?sslmode=disable&search_path=notifications

# --- MongoDB (Document Store for Dossiers, Timelines, Snapshots, Catalog, TTL Logs) ---
MONGO_URI=mongodb://mongo_admin:mongo_password@localhost:27017/commerce_lab_doc?authSource=admin
MONGO_DATABASE=commerce_lab_doc

# --- Redis (Cart, Cache, Rate-Limiter, SSE Real-time Pub/Sub) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- Kafka / Redpanda Event Broker ---
KAFKA_BROKERS=localhost:19092

# --- AWS S3 (Direct S3 Integration - No MinIO) ---
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=commerce-lab-retail-assets
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- JWT Security ---
JWT_ACCESS_SECRET=commerce_lab_access_secret_key_change_in_prod
JWT_REFRESH_SECRET=commerce_lab_refresh_secret_key_change_in_prod
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
